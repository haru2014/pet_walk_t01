{
  "expo": {
    "name": "편안하개",
    "slug": "petwalk-production",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "petwalk",
    "owner": "pettrail",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "url": "https://u.expo.dev/52ded2f2-d6e7-420f-9c9f-3d999f262454"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "화면이 꺼진 주머니 속에서도 안심 산책 경로를 안내하기 위해 위치 권한이 필요해요.",
          "locationWhenInUsePermission": "안심 산책 경로를 안내하기 위해 위치 권한이 필요해요.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petwalk.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSPhotoLibraryUsageDescription": "반려견 대표 사진을 등록하기 위해 사진 보관함 접근 권한이 필요합니다.",
        "NSCameraUsageDescription": "반려견 사진을 직접 촬영하기 위해 카메라 접근 권한이 필요합니다."
      }
    },
    "android": {
      "package": "com.petwalk.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "52ded2f2-d6e7-420f-9c9f-3d999f262454"
      }
    }
  }
}

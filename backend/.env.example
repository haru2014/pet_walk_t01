# ==============================================================================
# 편안하개 (PetWalk) - 백엔드 및 인프라 환경 변수 템플릿 (.env.example)
# ==============================================================================

# [1. Supabase PostgreSQL & Auth 연동]
# docs/01_편안하개_인프라_구축_및_환경설정_가이드.md 참조
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [2. Routing API - OpenRouteService (선택 사항)]
ORS_API_KEY=your_ors_token_here

# [3. AI Engine - Google Gemini API Key (선택 사항)]
GEMINI_API_KEY=your_gemini_api_key_here

# [4. 기상청 단기예보 (공공데이터포털 Decoding 인증키)]
# 따옴표·공백 없이 KMA_SERVICE_KEY=키값 형태로 적습니다. 비어 있으면 날씨 연동이 동작하지 않습니다.
KMA_SERVICE_KEY=

# [5. DEM 고도 파일 폴더 (선택 사항)]
# 이 폴더(하위 폴더 포함)의 .tif / .tiff / .img 를 모두 읽어 가장 촘촘한 자료를 우선 씁니다.
# 비어 있거나 범위 밖이면 근사 고도 모델을 씁니다 (기본값).
# 저장소에 포함된 대전·세종 Copernicus 파일을 쓰려면 DEM_DIR=data/dem (backend 폴더 기준 상대 경로).
# 출처 표기 의무는 backend/data/dem/NOTICE.md 참고.
DEM_DIR=

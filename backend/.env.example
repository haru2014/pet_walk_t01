# ==============================================================================
# 편안하개 (PetWalk) - 백엔드 및 인프라 환경 변수 템플릿 (.env.example)
# ==============================================================================

# [1. Supabase PostgreSQL & Auth 연동]
# docs/01_편안하개_인프라_구축_및_환경설정_가이드.md 참조
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# [2. Routing API - OpenRouteService (선택 사항)]
ORS_API_KEY=your_ors_token_here

# [3. AI Engine - Google Gemini API Key (선택 사항)]
GEMINI_API_KEY=your_gemini_api_key_here

# [4. 기상청 단기예보 & 에어코리아 대기질 (공공데이터포털 Decoding 인증키)]
# 따옴표·공백 없이 KMA_SERVICE_KEY=키값 형태로 적습니다. 비어 있으면 날씨 연동이 동작하지 않습니다.
KMA_SERVICE_KEY=
# 에어코리아(한국환경공단) 실시간 대기질(미세먼지) 인증키 (공공데이터포털 일반 인증키 공유 가능)
# 비어있으면 KMA_SERVICE_KEY를 재사용하거나 Open-Meteo Air Quality 실시간 API로 자동 폴백합니다.
AIRKOREA_SERVICE_KEY=

# [5. DEM 고도 파일 폴더 (선택 사항)]
# 이 폴더(하위 폴더 포함)의 .tif / .tiff / .img 를 모두 읽어 가장 촘촘한 자료를 우선 씁니다.
# DEM_DIR 을 아예 적지 않으면 저장소에 포함된 대전·세종 Copernicus 파일(backend/data/dem)을 씁니다 (기본값, #76).
# DEM_DIR=off (또는 빈 값) 이면 DEM 을 끄고 근사 고도 모델을 씁니다. 범위 밖 지점도 근사 고도를 씁니다.
# 다른 자료(국토지리정보원 90m 등)를 쓰려면 그 폴더 경로를 적습니다 (상대 경로는 backend 폴더 기준).
# 출처 표기 의무는 backend/data/dem/NOTICE.md 참고 (경로 응답의 elevation_source.attribution 을 앱이 표시).
# DEM_DIR=off
